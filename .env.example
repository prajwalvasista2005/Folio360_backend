# ==============================================================================
# Folio360 Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development overrides.
# Never commit real credentials or .env files to source control.

# Application Information
APP_NAME=Folio360
APP_VERSION=1.0.0
APP_DESCRIPTION="Folio360: A User-Centred Unified Profile for Academic, Professional, and Lifelong Learning Records."

# Environment & Debug
ENVIRONMENT=development
DEBUG=true

# API Routing
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# CORS Configuration (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Documentation Endpoints
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# ==============================================================================
# Stage 2: Database Configuration (Synchronous SQLAlchemy 2.0 + psycopg v3)
# ==============================================================================
# Required format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# - Must use the least-privilege app role (folio360_dev_user), never admin/superuser.
# - Local dev Compose binds PostgreSQL `db` to 127.0.0.1:5433 (host 5432 is avoided).
# - In ENVIRONMENT=production, DATABASE_URL is required and DB_ECHO must be false.
# - URL-encode any special characters in custom passwords.
# - Password below is a local-only placeholder matching docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://folio360_dev_user:folio360_dev_pass@127.0.0.1:5433/folio360_dev

# Connection pool size (valid range: 1..50)
DB_POOL_SIZE=5

# Maximum overflow connections above DB_POOL_SIZE (valid range: 0..100)
DB_MAX_OVERFLOW=10

# Seconds to wait for a connection from the pool (valid range: 1..120)
DB_POOL_TIMEOUT=30

# Seconds for psycopg TCP connection establishment (valid range: 1..30)
DB_CONNECT_TIMEOUT=5

# Log SQL statements; temporary local debugging only (forbidden in production)
DB_ECHO=false

# ==============================================================================
# Stage 2: Readiness Probe Configuration (GET /api/v1/health/ready)
# ==============================================================================
# Budget rule: DB_READINESS_CONNECT_TIMEOUT + (DB_READINESS_QUERY_TIMEOUT_MS / 1000.0) <= 5.0

# Per-process BoundedSemaphore permits for readiness probes (valid range: 1..10)
DB_READINESS_MAX_CONCURRENCY=2

# Seconds for readiness NullPool connect_timeout (valid range: 1..4)
DB_READINESS_CONNECT_TIMEOUT=3

# Milliseconds for readiness SET LOCAL statement_timeout (valid range: 100..3000)
DB_READINESS_QUERY_TIMEOUT_MS=1000

# ==============================================================================
# Stage 2: Docker Compose PostgreSQL Services (Local-Only Placeholders)
# ==============================================================================
# Note: /docker-entrypoint-initdb.d/init-least-privilege.sh runs ONLY when a
# PostgreSQL data directory is created empty. Changing POSTGRES_DEV_* values after
# `folio360_pg_dev_data` exists will NOT update existing DB roles or passwords.
# Variable names below match docker-compose.yml 1:1.

# Development Database Service (`db` -> folio360_db_dev on 127.0.0.1:5433)
POSTGRES_DEV_ADMIN_USER=folio360_dev_admin
POSTGRES_DEV_ADMIN_PASSWORD=folio360_dev_admin_pass
POSTGRES_DEV_DB=folio360_dev
POSTGRES_DEV_APP_USER=folio360_dev_user
POSTGRES_DEV_APP_PASSWORD=folio360_dev_pass

# Test Database Service (`db_test` -> folio360_db_test on 127.0.0.1:5434, tmpfs)
POSTGRES_TEST_ADMIN_USER=folio360_test_admin
POSTGRES_TEST_ADMIN_PASSWORD=folio360_test_admin_pass
POSTGRES_TEST_DB=folio360_test
POSTGRES_TEST_APP_USER=folio360_test_user
POSTGRES_TEST_APP_PASSWORD=folio360_test_pass

# ==============================================================================
# Stage 2: Pytest Integration & Migration Test URL (Commented by Default)
# ==============================================================================
# Tests enforce two-stage identity checks: database name must end with `_test`,
# and role must NOT be `postgres`, `folio360_dev*`, `*_admin`, or a superuser.
# Host execution (Windows venv against 127.0.0.1:5434):
# TEST_DATABASE_URL=postgresql+psycopg://folio360_test_user:folio360_test_pass@127.0.0.1:5434/folio360_test
# Isolated container execution on `folio360_net` (against db_test:5432):
# TEST_DATABASE_URL=postgresql+psycopg://folio360_test_user:folio360_test_pass@db_test:5432/folio360_test
