# ==============================================================================
# Folio360 Backend - Environment Configuration Example (Stage 3A)
# ==============================================================================
# Copy this file to .env for local development overrides.
# Never commit real credentials or .env files to source control.

# Application Information
APP_NAME=Folio360
APP_VERSION=1.0.0
APP_DESCRIPTION="Folio360: A User-Centred Unified Profile for Academic, Professional, and Lifelong Learning Records."

# Environment & Debug ("development", "testing", or "production")
ENVIRONMENT=development
DEBUG=true

# API Routing
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# CORS Configuration (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Documentation Endpoints
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# ==============================================================================
# Stage 2 & 3A: Database Configuration (Split Migrator DDL vs. App DML Roles)
# ==============================================================================
# Required format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# - DATABASE_URL MUST use the least-privilege DML-only app role (folio360_dev_app).
# - MIGRATION_DATABASE_URL MUST use the schema-owner migrator role (folio360_dev_migrator)
#   and is consumed exclusively by Alembic (never passed to the runtime API server).
# - Local dev Compose binds PostgreSQL `db` to 127.0.0.1:5433 (host 5432 is avoided).
# - In ENVIRONMENT=production, DATABASE_URL is required and DB_ECHO must be false.
# - Passwords below are local-only placeholders matching docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://folio360_dev_app:folio360_dev_app_pass@127.0.0.1:5433/folio360_dev
# MIGRATION_DATABASE_URL=postgresql+psycopg://folio360_dev_migrator:folio360_dev_migrator_pass@127.0.0.1:5433/folio360_dev

# Connection pool size (valid range: 1..50)
DB_POOL_SIZE=5

# Maximum overflow connections above DB_POOL_SIZE (valid range: 0..100)
DB_MAX_OVERFLOW=10

# Seconds to wait for a connection from the pool (valid range: 1..120)
DB_POOL_TIMEOUT=30

# Seconds for psycopg TCP connection establishment (valid range: 1..30)
DB_CONNECT_TIMEOUT=5

# Log SQL statements; temporary local debugging only (forbidden in production)
DB_ECHO=false

# ==============================================================================
# Stage 2: Readiness Probe Configuration (GET /api/v1/health/ready)
# ==============================================================================
# Budget rule: DB_READINESS_CONNECT_TIMEOUT + (DB_READINESS_QUERY_TIMEOUT_MS / 1000.0) <= 5.0
DB_READINESS_MAX_CONCURRENCY=2
DB_READINESS_CONNECT_TIMEOUT=3
DB_READINESS_QUERY_TIMEOUT_MS=1000

# ==============================================================================
# Stage 3A: Authentication, JWT, Cookies, Email Verification & Proxy Security
# ==============================================================================
# Replace with a cryptographically random >= 32-char secret before any non-local use.
JWT_SECRET_KEY=dev-only-placeholder-jwt-secret-key-at-least-32-chars
JWT_ISSUER=folio360
JWT_AUDIENCE=folio360-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_ABSOLUTE_EXPIRE_DAYS=30

# Cookie deployment mode: "same_site" (recommended in production) or "cross_site"
COOKIE_DEPLOYMENT_MODE=same_site
REFRESH_COOKIE_NAME=folio360_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=

# Frontend return & email-verification configuration
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_MOBILE_LOGIN_URIS=["folio360://auth/login"]

EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_COOLDOWN_SECONDS=60
EMAIL_MAX_PER_HOUR=3
EMAIL_FAILED_RETRY_BACKOFF_SECONDS=10
EMAIL_PENDING_STALE_SECONDS=30
EMAIL_SEND_TIMEOUT_SECONDS=5.0

# SMTP Email Delivery (default host/port target Gmail STARTTLS; user/password required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@folio360.local

# Process-local sliding-window IP rate limiter (must be true in production)
RATE_LIMIT_ENABLED=true

# Uvicorn ASGI3 proxy trust boundary (python -m app.server)
PROXY_HEADERS_ENABLED=false
TRUSTED_PROXY_IPS=[]

# ==============================================================================
# Stage 3C: OAuth 2.0 / OIDC Authentication (Google & GitHub)
# ==============================================================================
BACKEND_BASE_URL=http://localhost:8000
OAUTH_BINDING_COOKIE_NAME=folio360_oauth_binding
OAUTH_EXCHANGE_COOKIE_NAME=folio360_oauth_exchange
OAUTH_ALLOWED_WEB_REDIRECT_URIS=["http://localhost:5173/auth/oauth/callback"]
OAUTH_ALLOWED_MOBILE_REDIRECT_URIS=["folio360://auth/callback"]
OAUTH_STATE_EXPIRE_MINUTES=10
OAUTH_HTTP_TIMEOUT_SECONDS=5.0
GITHUB_EMAILS_PER_PAGE=100
GITHUB_EMAILS_MAX_PAGES=10
# OAUTH_PKCE_ENCRYPTION_KEY=<43-char-canonical-base64url-32-byte-key>
# OAUTH_PKCE_ENCRYPTION_KEY_PREVIOUS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TRUSTED_ADDITIONAL_AUDIENCES=[]
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ==============================================================================
# Phase 2 Stage 4: Document Vault & Storage
# ==============================================================================
STORAGE_BACKEND=local
DOCUMENT_LOCAL_STORAGE_DIR=/tmp/folio360_documents
DOCUMENT_MAX_SIZE_BYTES=10485760
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# DOCUMENT_SIGNING_SECRET=<optional-hmac-secret-defaults-to-JWT_SECRET_KEY>
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ==============================================================================
# Phase 2 Stage 5: File Validation, Quarantine & Malware Scanning
# ==============================================================================
DOCUMENT_QUARANTINE_NAMESPACE=quarantine
DOCUMENT_TRUSTED_NAMESPACE=trusted
# Production/staging enforces MALWARE_SCANNER_BACKEND=clamav (never mock).
MALWARE_SCANNER_BACKEND=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_UNIX_SOCKET=/var/run/clamav/clamd.ctl
DOCUMENT_SCAN_TIMEOUT_SECONDS=10.0
DOCUMENT_SCAN_PROCESSING_MODE=inline
DOCUMENT_SCAN_MAX_RETRIES=3
DOCUMENT_SCAN_STALE_SECONDS=300
DOCUMENT_REJECTED_RETENTION_POLICY=delete

# ==============================================================================
# Phase 2 Stage 6: AI Analyzer (Document Understanding & Structured Extraction)
# ==============================================================================
# Provider options: none | gemini | mock (mock is blocked in production/staging)
AI_ANALYZER_PROVIDER=none
# AI_ANALYZER_API_KEY=
AI_ANALYZER_MODEL=gemini-2.5-flash
AI_ANALYZER_BASE_URL=https://generativelanguage.googleapis.com
AI_ANALYZER_TIMEOUT_SECONDS=30.0
AI_ANALYZER_MAX_RETRIES=3
AI_ANALYZER_MAX_INPUT_BYTES=10485760
AI_ANALYZER_PROCESSING_MODE=inline
AI_ANALYZER_STALE_SECONDS=300

# ==============================================================================
# Phase 3: Projects Portfolio & Separate GitHub Integration
# ==============================================================================
# Separate GitHub OAuth App credentials for browsing/importing repositories
# (kept distinct from Stage 3C GITHUB_CLIENT_ID/SECRET login credentials because
# GitHub OAuth Apps allow only one Authorization callback URL:
#   - Login OAuth:     <BACKEND_BASE_URL>/api/v1/auth/oauth/github/callback
#   - Portfolio sync:  <BACKEND_BASE_URL>/api/v1/github/callback
# In production, OAUTH_PKCE_ENCRYPTION_KEY is also required to encrypt tokens.)
# GITHUB_PORTFOLIO_CLIENT_ID=
# GITHUB_PORTFOLIO_CLIENT_SECRET=
GITHUB_PORTFOLIO_SCOPE="read:user repo"
PROJECT_IMAGE_MAX_SIZE_BYTES=5242880

# ==============================================================================
# Docker Compose PostgreSQL Services (Local-Only Placeholders)
# ==============================================================================
# Note: /docker-entrypoint-initdb.d/init-least-privilege.sh runs ONLY when a
# PostgreSQL data directory is created empty. Changing POSTGRES_DEV_* values after
# `folio360_pg_dev_data` exists will NOT update existing DB roles or passwords.

# Development Database Service (`db` -> folio360_db_dev on 127.0.0.1:5433)
POSTGRES_DEV_ADMIN_USER=folio360_dev_admin
POSTGRES_DEV_ADMIN_PASSWORD=folio360_dev_admin_pass
POSTGRES_DEV_DB=folio360_dev
POSTGRES_DEV_MIGRATOR_USER=folio360_dev_migrator
POSTGRES_DEV_MIGRATOR_PASSWORD=folio360_dev_migrator_pass
POSTGRES_DEV_APP_USER=folio360_dev_app
POSTGRES_DEV_APP_PASSWORD=folio360_dev_app_pass

# Test Database Service (`db_test` -> folio360_db_test on 127.0.0.1:5434, tmpfs)
POSTGRES_TEST_ADMIN_USER=folio360_test_admin
POSTGRES_TEST_ADMIN_PASSWORD=folio360_test_admin_pass
POSTGRES_TEST_DB=folio360_test
POSTGRES_TEST_MIGRATOR_USER=folio360_test_migrator
POSTGRES_TEST_MIGRATOR_PASSWORD=folio360_test_migrator_pass
POSTGRES_TEST_APP_USER=folio360_test_app
POSTGRES_TEST_APP_PASSWORD=folio360_test_app_pass

# ==============================================================================
# Pytest Integration & Migration Test URLs (Commented by Default)
# ==============================================================================
# Tests enforce strict database identity checks: database name must end with `_test`,
# TEST_DATABASE_URL must use a non-admin, non-dev, non-migrator DML-only role, and
# TEST_MIGRATION_DATABASE_URL must use the `_test` schema-owner migrator role.
# Isolated container execution on `folio360_net` (against db_test:5432):
# TEST_DATABASE_URL=postgresql+psycopg://folio360_test_app:folio360_test_app_pass@db_test:5432/folio360_test
# TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://folio360_test_migrator:folio360_test_migrator_pass@db_test:5432/folio360_test
