# ==============================================================================
# Folio360 Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development overrides.
# Never commit real credentials or .env files to source control.

# Application Information
APP_NAME=Folio360
APP_VERSION=1.0.0
APP_DESCRIPTION="Folio360: A User-Centred Unified Profile for Academic, Professional, and Lifelong Learning Records."

# Environment & Debug
ENVIRONMENT=development
DEBUG=true

# API Routing
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# CORS Configuration (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Documentation Endpoints
DOCS_URL=/docs
OPENAPI_URL=/openapi.json
